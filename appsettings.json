{
    "$schema": "appsettings-schema.json",
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "System": "Warning"
            }
        }
    },
    "Umbraco": {
        "CMS": {
            "Global": {
                "Id": "604dab8b-fe36-4edf-98c7-2f643c4d3399",
                "UseHttps": true,
                "SanitizeTinyMce": true
            },
            "Content": {
                "AllowEditInvariantFromNonDefault": true,
                "ContentVersionCleanupPolicy": {
                    "EnableCleanup": true
                }
            },
            "Unattended": {
                "UpgradeUnattended": true
            },
            "Runtime": {
                "Mode": "Production"
            },
            //"ModelsBuilder": {
            //    "ModelsMode": "Nothing"
            //},
            "ModelsBuilder": {
                "ModelsMode": "SourceCodeAuto",
                "ModelsNamespace": "UmbracoProject1.Models",
                "ModelsDirectory": "~/../UmbracoProject1.Models",
                "AcceptUnsafeModelsDirectory": true

            },
            "Security": {
                "AllowConcurrentLogins": false
            }
        }
    }



}